// Cloudflare deployment: a static-assets-only Worker serving web/ (built by `npm run build:web`).
// Connected to the GitHub repo with Workers Builds, every push to the production branch builds and deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margin",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  }
}
