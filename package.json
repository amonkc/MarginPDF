{
  "name": "margin-pdf-editor",
  "private": true,
  "license": "MIT",
  "version": "2.25.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && vite build && node scripts/artifact.mjs",
    "build:web": "tsc && vite build --mode web && node scripts/web.mjs",
    "serve:web": "node scripts/serve.mjs web 8788",
    "test": "node tests/e2e.mjs",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "harfbuzzjs": "1.6.3",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@types/nspell": "^2.1.6",
    "typescript": "5.8",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "^4.164.0"
  }
}
